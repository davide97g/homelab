<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinema - a Findroid fork.
  The brand mark, at UI scale: Lucide's `film` on a 24-unit grid, the same shape
  the launcher icon and the web app's rail draw. @color/cinema_primary is
  generated from packages/design-tokens/tokens.json, so it cannot drift from the
  palette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
  <group
      android:scaleX="3.6667"
      android:scaleY="3.6667"
      android:translateX="6"
      android:translateY="6">
    <path
        android:pathData="M5,3 h14 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 z M7,3 V21 M3,7.5 H7 M3,12 H21 M3,16.5 H7 M17,3 V21 M17,7.5 H21 M17,16.5 H21"
        android:strokeColor="@color/cinema_primary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
  </group>
</vector>
