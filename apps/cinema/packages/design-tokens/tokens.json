{
  "$name": "Nebula",
  "$description": "Cinema's design language: deep violet canvas, glass panels, one hot-pink action colour. Authored once here, emitted to CSS custom properties (web), Swift (apps/ios) and Kotlin (apps/android) so the three clients cannot drift apart.",
  "color": {
    "canvas-deep": { "hex": "#0B0610", "use": "Page behind the panels -- the darkest thing on screen." },
    "canvas": { "hex": "#150A1C", "use": "Default app background inside the frame." },
    "surface": { "hex": "#241130", "use": "Panels: sidebar, rails, hero card." },
    "surface-2": { "hex": "#30193E", "use": "Raised: cards, active nav pill, inputs." },
    "surface-3": { "hex": "#3C2049", "use": "Hover / pressed state of surface-2." },
    "border": { "hex": "#4A2A57", "use": "Hairline between surfaces." },
    "foreground": { "hex": "#F6EDFA", "use": "Primary text." },
    "muted-foreground": { "hex": "#B296C2", "use": "Secondary text, inactive nav, metadata." },
    "primary": { "hex": "#F2308C", "use": "The single action colour. Play, submit, active." },
    "primary-foreground": { "hex": "#FFFFFF", "use": "Text on primary." },
    "primary-soft": { "hex": "#FF6FB0", "use": "Active nav label, links, focus ring." },
    "violet": { "hex": "#8B4BFF", "use": "Second accent: chips, charts, nebula glow." },
    "amber": { "hex": "#FFB020", "use": "Badges that flag status -- Popular, New." },
    "green": { "hex": "#3ED598", "use": "Online / available / watched." },
    "danger": { "hex": "#FF4D5E", "use": "Destructive and offline-storage states." }
  },
  "alpha": {
    "scrim": { "value": "rgb(11 6 16 / 0.82)", "use": "Behind modals and sticky bars." },
    "glass": { "value": "rgb(48 25 62 / 0.55)", "use": "Panel fill over artwork." },
    "hairline": { "value": "rgb(255 255 255 / 0.08)", "use": "Border on glass." }
  },
  "radius": {
    "sm": "0.625rem",
    "md": "0.875rem",
    "lg": "1.25rem",
    "xl": "1.75rem",
    "2xl": "2.25rem",
    "pill": "999px"
  },
  "shadow": {
    "panel": "0 24px 60px -24px rgb(0 0 0 / 0.75)",
    "card": "0 16px 40px -20px rgb(0 0 0 / 0.7)",
    "primary-glow": "0 10px 30px -8px rgb(242 48 140 / 0.55)"
  },
  "type": {
    "sans": "\"Geist Variable\", ui-sans-serif, system-ui, sans-serif",
    "display": "\"Bricolage Grotesque Variable\", \"Geist Variable\", sans-serif"
  },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "fast": "140ms",
    "base": "260ms"
  }
}
