<?xml version="1.0" encoding="utf-8"?>
<!-- The glass pills and tiles the design uses everywhere: a wash of white over the
     picture, with a hairline so the shape survives a bright still behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="@color/hairline" />
    <corners android:radius="20dp" />
</shape>
