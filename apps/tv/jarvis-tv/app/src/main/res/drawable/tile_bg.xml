<?xml version="1.0" encoding="utf-8"?>
<!-- DPAD focus has to be unmistakable from three metres away: the card lifts to a
     lighter surface AND gains a 3dp accent border. Colour alone is not enough. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
