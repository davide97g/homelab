<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Near-black with a blue cast rather than pure black: #000 on this LCD shows the
         backlight edges, and Ambilight reads the frame's average colour, so a flat
         black screen would leave the room dark. -->
    <color name="bg">#05080C</color>
    <color name="surface">#0FFFFFFF</color>
    <color name="surface_hi">#1AFFFFFF</color>
    <color name="hairline">#1AFFFFFF</color>
    <color name="surface_raised">#1FFFFFFF</color>

    <color name="accent">#4DE8F4</color>

    <color name="text_primary">#F2F7FA</color>
    <color name="text_secondary">#A8F2F7FA</color>
    <color name="text_faint">#66F2F7FA</color>

    <color name="ok">#4ADE80</color>
    <color name="warn">#FBBF24</color>
    <color name="ivory">#F4EDE2</color>
    <color name="err">#F87171</color>
</resources>
