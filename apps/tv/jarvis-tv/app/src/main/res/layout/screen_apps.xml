<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop, macOS style: a menu bar along the top, the dock along the bottom,
     and the painting (WallpaperView, in activity_home.xml) between them. dp values
     are 1920x1080 preview pixels halved: the set runs at 320 dpi. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenApps"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ── menu bar: no bar at all, just the words floating on the painting,
         white with a soft shadow so they hold on any part of it ──────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/menubar_scrim" />

    <LinearLayout
        android:id="@+id/masthead"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="18dp">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/menubar_dot"
            android:elevation="1dp" />

        <it.davideghiotto.jarvistv.TabView
            android:id="@+id/tabHome"
            style="@style/StudioTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora_medium"
            android:text="@string/tab_home" />

        <it.davideghiotto.jarvistv.TabView
            android:id="@+id/tabSettings"
            style="@style/StudioTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/clock"
            style="@style/StudioTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/menubar_ink" />
    </LinearLayout>

    <!-- ── dock ─────────────────────────────────────────────────────────────── -->
    <it.davideghiotto.jarvistv.DockView
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom" />
</FrameLayout>
