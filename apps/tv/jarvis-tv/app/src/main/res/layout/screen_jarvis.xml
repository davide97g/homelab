<?xml version="1.0" encoding="utf-8"?>
<!-- The orb owns the frame here: no panel, no card, and the showcase dimmed away
     behind it. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screenJarvis"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/orbState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:letterSpacing="0.46"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_orb_state"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- the orb sits in the space above the transcript, never over it -->
    <it.davideghiotto.jarvistv.OrbView
        android:id="@+id/orb"
        android:layout_width="430dp"
        android:layout_height="430dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orbState"
        app:layout_constraintBottom_toTopOf="@id/jarvisPrompt"
        app:layout_constraintVertical_bias="0.42" />

    <TextView
        android:id="@+id/jarvisPrompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_orb_prompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="660dp"
        app:layout_constraintBottom_toTopOf="@id/jarvisReply"
        android:layout_marginBottom="11dp" />

    <TextView
        android:id="@+id/jarvisReply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_orb_reply"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="660dp"
        app:layout_constraintBottom_toTopOf="@id/jarvisWayfind"
        android:layout_marginBottom="26dp" />

    <LinearLayout
        android:id="@+id/jarvisWayfind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="23dp">

        <TextView
            style="@style/Wayfind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wayfind_up_apps" />

        <TextView
            style="@style/Wayfind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="@string/wayfind_down_homelab" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
