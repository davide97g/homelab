# Copy to .env on the mini PC. The real values live in ../../../.env on the Mac.
OPENAI_API_KEY=sk-...
# Both default to a working model; override when OpenAI retires one.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# The Jellyfin the TV actually uses: Ilario's NAS, over Tailscale from the box.
# Not the mini PC's own Jellyfin on :8096 -- that one has a different library and
# the TV has never been signed into it.
JELLYFIN_URL=http://${NAS_TAILNET_IP}:8899
JELLYFIN_TOKEN=...
JELLYFIN_USER_ID=...
JELLYFIN_DEVICE=TV Davide
