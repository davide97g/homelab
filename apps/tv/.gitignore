# ── secrets: never commit, in any subdirectory ──────────────────────────────────
# The real credentials live in the homelab project's .env, one level up and outside
# this repo. Only .env.example (placeholders) is tracked here.
.env
.env.*
!.env.example
*.pem
*.key

# ── android ─────────────────────────────────────────────────────────────────────
local.properties
.gradle/
.kotlin/
**/build/
*.apk
*.keystore
!debug.keystore
.idea/
*.iml

# ── node ────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── os ──────────────────────────────────────────────────────────────────────────
.DS_Store

# ── editor ──────────────────────────────────────────────────────────────────────
.cursor/

# ── debloat state, per TV ───────────────────────────────────────────────────────
scripts/.debloated.txt
scripts/.inventory.txt

# ── artwork we may use on our TV but not publish ─────────────────────────────
tv-preview/assets/private/*
!tv-preview/assets/private/README.md
jarvis-tv/app/src/private/*
!jarvis-tv/app/src/private/README.md
