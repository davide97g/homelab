# /volume1/docker/accounts/.env on the NAS. Never committed.
APP_URL=https://accounts.davideghiotto.it
COOKIE_DOMAIN=.davideghiotto.it
TRUSTED_ORIGINS=https://cinema.davideghiotto.it,https://memories.davideghiotto.it,https://cassette.davideghiotto.it
ADMIN_EMAILS=
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32 -- encrypts the upstream passwords. Back it up apart from the DB.
BROKER_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=Homelab <noreply@accounts.davideghiotto.it>
# Jellyfin: Dashboard > API Keys. Immich: an admin's API key, all permissions.
JELLYFIN_API_KEY=
IMMICH_API_KEY=
# Cinema's Discover: Seerr on the mini PC, by its public name (Tailscale :5055 is firewalled
# from the NAS). Seerr > Settings > General > API Key.
SEERR_URL=https://discover.davideghiotto.it
SEERR_API_KEY=
# Sign in with Google: a "Web application" OAuth client, redirect URI
# https://accounts.davideghiotto.it/api/auth/callback/google. Empty: no Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple: Services ID as CLIENT_ID (return URL .../api/auth/callback/apple),
# plus the Sign in with Apple key: team id, key id, the .p8 with newlines as \n. Empty: no Apple button.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Native apps whose own Apple id tokens are accepted (cassette's iPhone app).
APPLE_APP_BUNDLE_IDS=com.davideghiotto.cassette
# Phase 2, universal links / App Links.
APPLE_APP_LINKS=DA596D32QB.it.davideghiotto.cinema=/cinema/*;DA596D32QB.it.davideghiotto.memories=/memories/*
ANDROID_APP_LINKS=
