# Host-specific values. Compose reads these from .env for interpolation in compose.yaml
# (append them to the .env that already holds the Open WebUI secrets on the box).
LAN_HOST=box.local
LAN_IP=192.168.1.10
TAILNET_HOST=box
OPENUI_HOST=openui.example.com
LLM_HOST=llm.example.com
# Cloudflare DNS record ids, only needed to unpublish (see README).
CF_RECORD_ID_OPENUI=
CF_RECORD_ID_LLM=
