    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU utilisation",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "TOTAL",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
