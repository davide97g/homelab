# Copy to .env ON THE NAS (not here), mode 600. deploy.py refuses to run if the
# file is missing there. None of these values belong in git.
#
#   ssh nas 'umask 077 && cat > ~/nas-agents/.env'   # then paste, then Ctrl-D

# The Loki push endpoint published on the mini PC's cloudflared tunnel.
LOKI_PUSH_URL=https://loki-push.davideghiotto.it/loki/api/v1/push

# Cloudflare Access service token for that hostname:
#   Zero Trust -> Access -> Service Auth -> Create Service Token
# The token is shown once. The Access policy for loki-push must be
# "Service Auth" only -- no identity providers -- so a leaked URL is still a 403.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
