{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting"
  ],
  "timezone": "Europe/Rome",
  "schedule": [
    "before 7am on monday"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate: image and action updates",
  "semanticCommits": "enabled",
  "labels": [
    "deps"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "packageRules": [
    {
      "description": "Commit messages in the repo's style: chore(<app>): <image> <version>",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "{{parentDir}}"
    },
    {
      "description": "One PR per week for the whole monitoring stack; it deploys as one app anyway",
      "matchFileNames": [
        "apps/monitoring/**"
      ],
      "groupName": "monitoring stack",
      "semanticCommitScope": "monitoring"
    },
    {
      "description": "Actions only matter to CI, so all of them move together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": null
    },
    {
      "description": "Majors get their own PR and a label: Jellyfin 10->12 style one-way migrations live here",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "deps",
        "major"
      ]
    },
    {
      "description": "A postgres major needs a dump and restore, never a tag bump",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "imresamu/postgis"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Stay on even-numbered (LTS) Node majors",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": "/^\\d*[02468](\\.|-|$)/"
    },
    {
      "description": "nginx: stable lines only (even minor)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nginx"
      ],
      "allowedVersions": "/^1\\.\\d*[02468](\\.|-|$)/"
    },
    {
      "description": "searxng tags are <date>-<commit>; compare the date part only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "searxng/searxng"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$"
    },
    {
      "description": "linuxserver also publishes -ls<build> and version- tags; follow the plain upstream version",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/**"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "linuxserver's qBittorrent still carries 2020-era 14.x and 20.04.x tags that sort above 5.x",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "Built locally by the app's own workflow, not pulled",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "homelab-hub"
      ],
      "enabled": false
    },
    {
      "description": "The iOS and Android forks are vendored upstream code; their CI is theirs to update",
      "matchFileNames": [
        "apps/cinema/apps/android/**",
        "apps/cinema/apps/ios/**"
      ],
      "enabled": false
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "apps/cinema/apps/android/",
    "apps/cinema/apps/ios/",
    "archive/"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "compose.base.yml is a build.py template, not valid YAML; bump its image lines so they move with docker-compose.yml in the same PR",
      "managerFilePatterns": [
        "/(^|/)compose\\.base\\.yml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
