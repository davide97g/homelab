# Where the stack runs. Anything `ssh` accepts.
DEPLOY_HOST=homelab
DEPLOY_PATH=/home/davide/mediarr

# On the box. Holds torrents/ and library/.
MEDIA_ROOT=/home/davide/media
PUID=1000
PGID=1000
TZ=Europe/Rome

# The NAS's Tailscale address. jellyfin-proxy forwards to it; there is no other route.
NAS_TAILNET_IP=

# ProtonVPN, which qBittorrent's traffic goes through (gluetun). The private key
# of a WireGuard config made at account.protonvpn.com -> Downloads -> WireGuard,
# with NAT-PMP (port forwarding) ON and Moderate NAT OFF. On the box this lives in
# Dokploy's Environment tab for mediarr, not in a file.
WIREGUARD_PRIVATE_KEY=
# Optional; gluetun picks a P2P server in one of these.
VPN_SERVER_COUNTRIES=Switzerland,Netherlands
# gluetun's control API key (`openssl rand -hex 24`). The hub holds the same
# value, in its own Dokploy Environment tab, for the VPN card and kill switch.
GLUETUN_API_KEY=

# The Mac's Jellyfin (the `cinema` project), as the box sees it. Used by the
# Jellyseerr wizard; nothing reads it automatically.
JELLYFIN_URL=http://192.168.15.115:8096
