[Unit]
Description=Copy both restic repositories (box and NAS) to Backblaze B2
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=%h/ops/offsite/offsite.sh
# The first run uploads ~70 GB; later ones only the night's new data.
TimeoutStartSec=20h
Nice=10
IOSchedulingClass=idle
