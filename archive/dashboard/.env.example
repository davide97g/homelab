# Template for the box's /home/davide/mediarr-dash/.env.
#
# Do not fill this in and copy it up — run scripts/collect-env.sh on the box
# instead. It reads the *arr keys out of the running containers, so they never
# sit on a laptop or in this repo. This file documents what ends up there.

# --- login -------------------------------------------------------------------
# Required. The server refuses to start without it.
DASHBOARD_PASSWORD=
# Signs the session cookie. Leave it stable or every restart logs you out.
SESSION_SECRET=

# --- service credentials -----------------------------------------------------
# Read from the containers by collect-env.sh.
JELLYSEERR_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
# Jellyfin: Dashboard -> API Keys -> +
JELLYFIN_API_KEY=
# qBittorrent Web UI login. Blank if auth is bypassed for this subnet.
QBITTORRENT_USER=
QBITTORRENT_PASS=

# --- addresses ---------------------------------------------------------------
# Everything below has a working default; override only if something moves.
# Do not put the box's LAN IP here: it comes from DHCP and moves on its own.
#
# HOMELAB_HOST is the box as this container reaches it — `homelab-host` is
# mapped to the Docker host in docker-compose.yml. Set it to a real address
# only when running the server outside Docker.
# HOMELAB_HOST=homelab-host
# HOMELAB_PUBLIC_HOST is what the browser is handed for node links and the
# header, so it must resolve on the viewer's machine. `debian` is the tailnet
# name; `debian.local` works on the LAN via mDNS.
# HOMELAB_PUBLIC_HOST=debian
# JELLYSEERR_URL=http://homelab-host:5055
# RADARR_URL=http://homelab-host:7878
# SONARR_URL=http://homelab-host:8989
# PROWLARR_URL=http://homelab-host:9696
# BAZARR_URL=http://homelab-host:6767
# QBITTORRENT_URL=http://homelab-host:8080
# JELLYFIN_URL=http://homelab-host:8096
# PROMETHEUS_URL=http://prometheus:9090

# Where the node links should send the browser. Set for every service that has a
# public hostname, otherwise a LAN address is handed to a remote browser that
# cannot reach it. Nothing validates these — a wrong one is a silent dead link.
# JELLYSEERR_PUBLIC_URL=https://discover.davideghiotto.it
# JELLYFIN_PUBLIC_URL=https://streaming.davideghiotto.it
# GRAFANA_PUBLIC_URL=https://grafana.davideghiotto.it

# --- behaviour ---------------------------------------------------------------
# COOKIE_SECURE=true      # served over HTTPS; note the LAN address can then no longer log in
# SESSION_DAYS=30
# CACHE_MS=4000           # how long a snapshot is reused
# TIMEOUT_MS=6000         # per-service request budget
