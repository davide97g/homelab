# Homelab credentials — local only, never committed, never set inside any service
# this manages. Read this file first; don't re-discover the ids.
#
# These three sets are what a port onto this box needs end to end: Dokploy creates
# and deploys the app, Cloudflare publishes it on the tunnel and points DNS at it,
# and SSH is the escape hatch for everything the REST APIs don't cover.
# See docs/porting-to-homelab.md for the runbook that uses them.

# ── Dokploy on the mini PC ───────────────────────────────────────────────────────
# The LAN address is a DHCP lease, so this is the Tailscale MagicDNS name: it
# survives a new lease and works from outside the house. The key is per-user, so it
# manages every project on this Dokploy, not just one.
#   Auth header for every call: `x-api-key: $DOKPLOY_API_KEY`
#   POST bodies must be sent on stdin (`--data-binary @-`) or Dokploy answers PARSE_ERROR.
DOKPLOY_URL=
DOKPLOY_API_KEY=

# Dokploy's GitHub App on this host, owner davide97g. Every compose app built from a
# GitHub repo needs this id as `githubId`.
DOKPLOY_GITHUB_ID=

# ── Cloudflare ───────────────────────────────────────────────────────────────────
# Scoped to DNS edit on the zone + tunnel edit on the account. It does NOT carry
# `user/tokens/verify`, so that endpoint answering "Invalid API Token" is expected
# and means nothing — test it against `zones` instead.
#   Auth header: `Authorization: Bearer $CF_API_TOKEN`
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE=
CF_ZONE_ID=

# The one cloudflared tunnel this box runs, as a systemd service with a
# dashboard-managed token. Every public hostname is an ingress rule on it, and every
# public DNS record is a proxied CNAME to CF_TUNNEL_CNAME.
CF_TUNNEL_NAME=
CF_TUNNEL_ID=
CF_TUNNEL_CNAME=

# ── The box ──────────────────────────────────────────────────────────────────────
# `ssh homelab` — alias in ~/.ssh/config, key ~/.ssh/id_ed25519_homelab.
# Dokploy's REST API has no container-exec endpoint, so `docker exec` over SSH is how
# dumps, restores and one-off SQL get run.
HOMELAB_SSH=
HOMELAB_TAILNET=

# The NAS's own tunnel, created 2026-09-15. Separate from CF_TUNNEL_* above: it runs
# on Ilario's NAS as a systemd *user* service (`davide`, no root), publishes only
# jellyfin.davideghiotto.it -> http://localhost:8899, and keeps streaming traffic off
# the mini PC. Its credentials live on the NAS at ~/.cloudflared/, mode 600.
NAS_TUNNEL_NAME=
NAS_TUNNEL_ID=
NAS_TUNNEL_CNAME=

# ── The NAS ──────────────────────────────────────────────────────────────────────
# `ssh nas` — alias on the Mac and the box, key ~/.ssh/id_ed25519, user davide on
# ${NAS_TAILNET_IP} (Tailscale only; there is no other route to it).
#
# This is the UGOS *account* password for davide, which is also its sudo password.
# `davide` is in the `admin` group and so is in sudoers. sudo there REFUSES a piped
# password ("no password was provided"); it needs a tty (`ssh -t nas 'sudo …'`) or
# SUDO_ASKPASS. The two UGOS web-UI passwords are different and are rejected by sudo.
NAS_SSH=
NAS_HOST=
NAS_USER=
NAS_PASSWORD=

# ── JARVIS on the TV ─────────────────────────────────────────────────────────────
# OpenAI key for the JARVIS server on the mini PC (STT + chat + TTS). Pasted into a
# Claude Code session on 2026-09-16, so it is compromised by disclosure — rotate it
# at platform.openai.com once the server is running.
#   Auth header: `Authorization: Bearer $OPENAI_API_KEY`
OPENAI_API_KEY=

# The TV's JointSpace API needs no credentials for Ambilight: plain HTTP on :1925
# accepts writes to /6/ambilight/* unauthenticated. Port 1926 (HTTPS) does require
# digest pairing, but nothing we need lives only there.
TV_HOST=
TV_JOINTSPACE_URL=

# ── Jellyfin on Ilario's NAS ─────────────────────────────────────────────────────
# This is the Jellyfin the TV is signed into, not the mini PC's own on :8096. The box
# reaches it over Tailscale; the Mac cannot (no route from here).
#   Jellyfin 12 REJECTS X-Emby-Token with a 401. The only header it accepts is:
#   `Authorization: MediaBrowser Token="$JELLYFIN_NAS_TOKEN"`
# The TV is signed in as the `root` Jellyfin user there, which is whose library and
# sessions JARVIS drives.
JELLYFIN_NAS_URL=
JELLYFIN_NAS_TOKEN=
JELLYFIN_NAS_USER_ID=
JELLYFIN_NAS_DEVICE=

# ── Philips TV JointSpace pairing (secured API, port 1926) ───────────────────────
# Paired 2026-09-16. Unlocks input/key over HTTPS digest auth: volume (relayed to the
# Bose soundbar over ARC/CEC), the D-pad, Home/Back, and playback keys -- none of
# which the plain-HTTP port 1925 exposes. Digest username = the id, password = the key.
#   curl -sk --digest -u "$JOINTSPACE_ID:$JOINTSPACE_KEY" https://$TV_HOST:1926/6/powerstate
JOINTSPACE_ID=
JOINTSPACE_KEY=

# ── Open WebUI (local-ai) ────────────────────────────────────────────────────────
# Chat UI for the box's Ollama, public on the tunnel (no Access), LAN :3080. Admin created
# headless on 2026-09-24 from WEBUI_ADMIN_* in ~/local-ai/.env on the box (same values);
# public sign-up is off. Change the email/password in the UI, then update both places.
OPEN_WEBUI_URL=
OPEN_WEBUI_ADMIN_EMAIL=
OPEN_WEBUI_ADMIN_PASSWORD=

# Open WebUI user accounts (role user). Login is by email; Open WebUI has no username login.
OPEN_WEBUI_USER_LORDNIK_EMAIL=
OPEN_WEBUI_USER_LORDNIK_PASSWORD=

# ── LiteLLM gateway (local-ai) ───────────────────────────────────────────────────
# OpenAI/Anthropic-compatible API with per-user keys in front of the box's Ollama.
# Dashboard /ui, API /v1. The master key is root: it mints keys and users. Never hand it out.
# Master key, salt key and the Postgres password live in ~/local-ai/litellm.env on the box.
# UI admin is a real proxy_admin user; the shared UI_USERNAME/UI_PASSWORD login is disabled.
LITELLM_URL=
LITELLM_MASTER_KEY=
LITELLM_UI_ADMIN_USER=
LITELLM_UI_ADMIN_PASSWORD=
# Users (role internal_user: own keys and usage only). Login = email.
LITELLM_USER_LORDNIK_EMAIL=
LITELLM_USER_LORDNIK_PASSWORD=
